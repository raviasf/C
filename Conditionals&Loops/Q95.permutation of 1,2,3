/*Write a program to generate all combinations of 1, 2 and 3 using nested while loop.*/

//Level01

#include <stdio.h>
int main()
{
  int i=1;
  while(i<=3)
  {
    int j=1;
    while(j<=3)
    {
      int k=1;
      while(k<=3)
      {
        if (i!=j && i!=k && j!=k)
        {
          printf("%d %d %d",i,j,k);
        }
      k++;
      }
    j++;
    }
  i++;
  }
return 0;
}
